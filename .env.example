# Application
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://bylucky:bylucky_dev@localhost:5431/bylucky

# Single administrator account. Generate the hash with:
# npm run admin:hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-output-of-admin-hash-password

# Generate all three values with: npm run secrets:generate
# Keep each value at least 32 random bytes. Never commit real values.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CODE_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CONFIG_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64url-key
